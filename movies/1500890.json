  "reviews": [
    {
      "author": "Sierbahnn",
      "content": "This is a competent horror movie about PTSD and grieving families, then it becomes an entirely different movie after about an hour or so and turns into a religious supernatural horror movie which has very little to do with anything that has happened up to that point. It is an abrupt shift and one that I'm not sure the movie sustains adequately. It is certainly not a bad movie, and I enjoyed watching it, but the abrupt tonal shift is a bit much. It is well acted and the limited use of special effects is effective. It's still a good time. You just have to be prepared for the whiplash that signals the start of the third act.",
      "rating": 7,
      "createdAt": "2026-08-07T20:10:45Z"
    }
  ],
