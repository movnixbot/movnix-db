  "reviews": [
    {
      "author": "patient1",
      "content": "This is unlike other Documentaries I've watched before, even those being hosted and narrated by Sir Attenborough. \r\n\r\nIt feels like he's sharing piece of himself this time around, I've never in over 40+ years of watching these nature programs felt so much more than an education on the behavior and life of animals we share the planet with. \r\n\r\nSir Attenborough appears to Sharing more than just a story this time around and there will be moments that his voice cracks at what he is sharing about the lives of his story. \r\n\r\nAny and All Nature Fans or Fans of\r\nSir Attenborough and his Visceral way of sharing a story is unquestionably one not to be missed and enjoyed in a way that made my chest heavy like none before...",
      "rating": 9,
      "createdAt": "2026-04-18T04:26:43Z"
    }
