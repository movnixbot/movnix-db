  "reviews": [
    {
      "author": "Nick",
      "content": "A masterclass in queer horror! Adrian Chiarella brilliantly subverts the conversion therapy trope by turning the \"cleansing\" ritual into a living, shape-shifting nightmare. The entity taking the shape of what the boys desire most—each other—is a devastatingly poetic metaphor. Tyson Perkins’ gorgeous, bleak cinematography of rural Australia makes every frame feel loaded with dread. It’s atmospheric, deeply romantic, and utterly heartbreaking.",
      "rating": 8,
      "createdAt": "2026-06-21T01:20:43Z"
    }
  ],
