  "reviews": [
    {
      "author": "tender_buttkiss",
      "content": "Very very dark comedy. Rainn Wilson is superb in his role as a deeply troubled EMS who yearns to get out of his chosen field, struggling with the burnout inherrent in it, he finds himself being an unwilling tutor to a new young recruit doing a ride a long. Right from the start the two do not get along, made only worse by Rainn's co-worker - an eaually jaded EMS also looking to get out. By no means is this a perfect film, but it's got some really touching moments that brought me to tears.",
      "rating": 7,
      "createdAt": "2025-11-24T06:22:04Z"
    }
  ],
