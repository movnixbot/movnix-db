1485
01:28:13,162 --> 01:28:14,664
<font color="white"><i>Karena kau cantik</i></font><font color="white"></font>

1486
01:28:14,747 --> 01:28:16,666
<font color="white"><i>Aku menyukaimu</i></font><font color="white"></font>

1487
01:28:16,749 --> 01:28:19,544
<font color="white"><i>Aku menyukaimu karena kau baik</i></font><font color="white"></font>

1488
01:28:22,797 --> 01:28:24,048
<font color="white">Hei!</font><font color="white"></font>

1489
01:28:24,132 --> 01:28:26,092
<font color="white">Siapa yang menggantikan kita?</font><font color="white"></font>

1490
01:28:27,927 --> 01:28:29,304
<font color="white">Orang ini?</font><font color="white"></font>

1491
01:28:30,054 --> 01:28:31,514
<font color="white">Mereka panggil penyanyi trot?</font><font color="white"></font>

1492
01:28:31,597 --> 01:28:34,100
<font color="white">Hei, katanya kita tak bisa tampil</font><font color="white">
<font color="white">karena ada taifun.</font><font color="white"></font></font>

1493
01:28:34,183 --> 01:28:37,437
<font color="white">Padahal cuacanya cerah tadi.</font><font color="white">
<font color="white">Kenapa mendadak ada taifun? Sial!</font><font color="white"></font></font>

1494
01:28:37,520 --> 01:28:39,063
<font color="white">Diam!</font><font color="white"></font>

1495
01:28:39,147 --> 01:28:40,857
<font color="white">Jangan salah paham, Jang-poong.</font><font color="white"></font>

1496
01:28:49,907 --> 01:28:51,159
<font color="white">Aku menyukaimu…</font><font color="white"></font>

1497
01:28:51,242 --> 01:28:54,746
<font color="white">Sial, kalian sama sekali tak berubah.</font><font color="white"></font>

1498
01:28:56,414 --> 01:28:58,499
<font color="white">Tahukah kalian?</font><font color="white">
<font color="white">Kalian tak akan tampil hari ini.</font><font color="white"></font></font>

1499
01:28:58,583 --> 01:29:01,711
<font color="white">Paham? Pulanglah saja.</font><font color="white"></font>

