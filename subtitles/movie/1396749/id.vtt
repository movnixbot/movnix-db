1433
01:25:15,985 --> 01:25:18,488
<font color="white">Dia berbalik. Berbalik dan muntah.</font><font color="white">
<font color="white">Ya ampun.</font><font color="white"></font></font>

1434
01:25:18,571 --> 01:25:21,199
<font color="white">Si idiot itu berbalik dan muntah. Sial.</font><font color="white"></font>

1435
01:25:32,502 --> 01:25:36,506
<font color="white"><i>Aku tahu sejak pertemuan ketiga kita</i></font><font color="white"></font>

1436
01:25:39,425 --> 01:25:43,763
<font color="white"><i>Bahwa kau dan aku punya perasaan yang sama</i></font><font color="white"></font>

1437
01:25:44,514 --> 01:25:46,808
<font color="white">- Kita harus bergegas.</font><font color="white">
<font color="white">- Tentu.</font><font color="white"></font></font>

1438
01:25:52,856 --> 01:25:53,731
<font color="white">- Aku bisa.</font><font color="white">
<font color="white">- Sip.</font><font color="white"></font></font>

1439
01:25:53,815 --> 01:25:55,150
<font color="white">Dia akan naik sebentar lagi.</font><font color="white"></font>

1440
01:25:55,233 --> 01:25:56,359
<font color="white">Beres.</font><font color="white"></font>

1441
01:25:56,442 --> 01:25:57,443
<font color="white">Tae-poong.</font><font color="white"></font>

1442
01:25:58,945 --> 01:25:59,779
<font color="white">Hei.</font><font color="white"></font>

1443
01:26:00,947 --> 01:26:03,241
<font color="white">Untuk apa kau kemari?</font><font color="white"></font>

1444
