00:23:40,530 --> 00:23:44,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Joaquin Torres dan Kapten Amerika
kita sendiri, Sam Wilson.</font></font></font></font>

439
00:23:56,480 --> 00:23:59,570
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Apa yang kita lakukan selanjutnya
dengan penemuan ini</font></font></font></font>

440
00:24:00,440 --> 00:24:03,480
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">akan menentukan
bagaimana sejarah menilai kita.</font></font></font></font>

441
00:24:03,590 --> 00:24:05,490
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Jika kita meratifikasi perjanjian ini,</font></font></font></font>

442
00:24:05,520 --> 00:24:08,630
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">bersama kita dapat memproduksi
cukup adamantium</font></font></font></font>

443
00:24:08,650 --> 00:24:11,670
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">untuk mendistribusikannya dengan adil
dan merata di seluruh dunia.</font></font></font></font>

444
00:24:15,590 --> 00:24:16,660
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Pak, Anda perlu duduk.</font></font></font></font>

445
00:24:19,550 --> 00:24:22,440
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Isaiah! Apa yang kau lakukan?</font></font></font></font>

446
00:24:30,560 --> 00:24:31,560
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Sam!</font></font></font></font>

447
00:24:38,450 --> 00:24:39,560
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Pak, apakah Anda tertembak?
- Tidak.</font></font></font></font>

448
00:24:39,580 --> 00:24:41,480
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ayo, ayo, ayo!</font></font></font></font>

449
00:25:02,460 --> 00:25:03,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Tn. Presiden, ikuti saya.</font></font></font></font>

450
00:25:35,650 --> 00:25:36,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Sial.</font></font></font></font>

451
00:25:51,570 --> 00:25:52,560
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Isaiah!</font></font></font></font>

452
00:26:09,650 --> 00:26:11,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Tiarap sekarang!
- Jangan bergerak.</font></font></font></font>

453
00:26:16,580 --> 00:26:17,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Apa yang terjadi?</font></font></font></font>

454
00:26:18,600 --> 00:26:21,520
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Entahlah.
Tapi kau harus berhenti.</font></font></font></font>

455
00:26:24,520 --> 00:26:25,640
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Berhenti!
- Jangan!</font></font></font></font>

456
00:26:29,640 --> 00:26:32,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Aku tak bisa kembali ke dalam, Sam.</font></font></font></font>

457
00:26:32,670 --> 00:26:35,530
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Lari, dan itu akan lebih buruk dari itu.</font></font></font></font>

458
00:26:39,530 --> 00:26:41,440
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Tolong, Isaiah.</font></font></font></font>

459
00:26:56,480 --> 00:26:57,550
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Hei, tenang saja!</font></font></font></font>

460
00:26:57,570 --> 00:26:59,670
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Jaga bajuku.</font></font></font></font>

461
00:27:00,440 --> 00:27:03,450
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Tolong, jaga bajuku.</font></font></font></font>

462
00:27:17,440 --> 00:27:18,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Kapten, aku tak bisa
membiarkanmu masuk.</font></font></font></font>

463
00:27:19,670 --> 00:27:21,490
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Hei!</font></font></font></font>

464
00:27:21,520 --> 00:27:22,580
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Sam!</font></font></font></font>

465
00:27:22,600 --> 00:27:25,470
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Pak, Pak tidak bisa—
Anda tidak bisa—</font></font></font></font>

466
00:27:26,450 --> 00:27:26,660
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Pak!</font></font></font></font>

467
00:27:27,550 --> 00:27:29,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Maaf, Pak Presiden.
- Hei, hei, hei.</font></font></font></font>

468
00:27:29,610 --> 00:27:30,660
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dia tetap di sini.</font></font></font></font>

469
00:27:30,680 --> 00:27:32,550
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Yang lain, keluar.</font></font></font></font>

470
00:27:36,369 --> 00:27:39,000
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14"><b>Penembakan di Gedung Putih
Super Soldier in Custody - Isaiah Bradley</b></font></font></font></font>

471
00:27:39,470 --> 00:27:40,640
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Agen Taylor, kau juga.</font></font></font></font>

472
00:27:47,550 --> 00:27:48,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Kau baik-baik saja?</font></font></font></font>

473
00:27:49,550 --> 00:27:51,500
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Aku yang seharusnya menanyakan itu
pada Anda, Pak.</font></font></font></font>

474
00:27:51,530 --> 00:27:52,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Bukan pertama kalinya aku ditembaki.</font></font></font></font>

475
00:27:53,450 --> 00:27:54,560
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Lihat, saya tahu bagaimana ini terlihat, tapi...</font></font></font></font>

476
00:27:57,590 --> 00:27:58,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Bisakah kita punya waktu sebentar?</font></font></font></font>

477
00:28:00,610 --> 00:28:01,610
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dia tetap di sini.</font></font></font></font>

478
00:28:03,600 --> 00:28:07,470
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ini Ruth Bat-Seraph,
penasihat keamananku.</font></font></font></font>

479
00:28:10,460 --> 00:28:12,500
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Pak, tidak mungkin Isaiah melakukan ini.</font></font></font></font>

480
00:28:12,530 --> 00:28:14,450
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Kecuali dia melakukannya.
- Mungkin seseorang mempengaruhinya.</font></font></font></font>

481
00:28:14,470 --> 00:28:15,530
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Kau benar-benar membela seorang pria</font></font></font></font>

482
00:28:15,550 --> 00:28:17,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">yang baru saja mencoba membunuh
Presiden di depan...</font></font></font></font>

483
00:28:17,610 --> 00:28:20,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Kita tidak tahu apa yang terjadi.
<i>- Cukup.</i></font></font></font></font>

484
00:28:22,630 --> 00:28:23,600
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Apa yang kita ketahui?</font></font></font></font>

485
00:28:24,370 --> 00:28:25,380
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ada lima penembak.</font></font></font></font>

486
00:28:25,450 --> 00:28:26,640
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Isaiah adalah salah satunya.</font></font></font></font>

487
00:28:26,660 --> 00:28:28,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Begitu juga dengan Dinas Rahasia
dan militer aktif.</font></font></font></font>

488
00:28:29,450 --> 00:28:31,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ini adalah serangan teroris
yang terkoordinasi, Pak.</font></font></font></font>

489
00:28:37,580 --> 00:28:38,580
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Apa lagi yang kau punya?</font></font></font></font>

490
00:28:39,460 --> 00:28:40,540
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Lagu sebelum penembakan,</font></font></font></font>

491
00:28:40,560 --> 00:28:42,480
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">kami pikir itu isyarat
untuk serangan.</font></font></font></font>

492
00:28:42,500 --> 00:28:44,450
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Pak, Isaiah terlihat seperti
dia tidak dalam kendali.</font></font></font></font>

493
00:28:44,470 --> 00:28:45,620
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dia tak tahu di mana dia berada.</font></font></font></font>

494
00:28:45,640 --> 00:28:47,580
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Jadi kau menyarankan apa?</font></font></font></font>

495
00:28:47,600 --> 00:28:48,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Biarkan aku menyelidikinya.</font></font></font></font>

496
00:28:49,680 --> 00:28:52,490
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Tidakkah kau pikir kau
terlalu dekat dengan ini?</font></font></font></font>

497
00:28:52,520 --> 00:28:54,520
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Pak, lingkaran dalam Anda
telah dikompromikan.</font></font></font></font>

498
00:28:54,540 --> 00:28:56,560
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ada kemungkinan
serangan lain sekarang.</font></font></font></font>

499
00:28:56,580 --> 00:28:58,450
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dan apa sebenarnya
yang kau tawarkan</font></font></font></font>

500
00:28:58,470 --> 00:29:00,670
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">yang tak bisa dilakukan oleh seluruh
aparat intelijen dan pertahanan kita?</font></font></font></font>

501
00:29:01,440 --> 00:29:02,580
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Aku tak akan duduk diam
dan membiarkan Isaiah...</font></font></font></font>

502
00:29:02,600 --> 00:29:06,490
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Lihat, aku tahu betapa pentingnya
Bradley bagimu.</font></font></font></font>

503
00:29:06,520 --> 00:29:08,470
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Tapi pertimbangkan penampilannya.</font></font></font></font>

504
00:29:09,550 --> 00:29:12,660
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Kapten Amerika melakukan
penyelidikan pribadi</font></font></font></font>

505
00:29:12,680 --> 00:29:16,600
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">terhadap teman yang mencoba
membunuh Presiden.</font></font></font></font>

506
00:29:16,620 --> 00:29:19,610
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Isaiah mengorbankan segalanya
untuk negara ini.</font></font></font></font>

507
00:29:19,630 --> 00:29:21,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dia seorang tentara. Seorang patriot.</font></font></font></font>

508
00:29:22,450 --> 00:29:23,550
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dia tak punya alasan untuk melakukan ini.</font></font></font></font>

509
00:29:23,570 --> 00:29:25,520
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dia punya setiap alasan.</font></font></font></font>

510
00:29:25,540 --> 00:29:27,610
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Bradley pernah dipenjara
karena menyelamatkan anak buahnya sendiri,</font></font></font></font>

511
00:29:27,630 --> 00:29:30,480
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">dieksperimen selama 30 tahun.</font></font></font></font>

512
00:29:30,500 --> 00:29:32,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Hal-hal yang dilakukan padanya
cukup untuk membuat siapa pun meledak.</font></font></font></font>

513
00:29:33,590 --> 00:29:35,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Pak, Anda mengundang saya ke sini
untuk bekerja sama.</font></font></font></font>

514
00:29:35,610 --> 00:29:38,560
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Jadi mari kita bekerja sama.
- Aku khawatir tawaran itu sudah kadaluarsa</font></font></font></font>

515
00:29:38,580 --> 00:29:40,530
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">ketika teman kau mencoba
membunuhku.</font></font></font></font>

516
00:29:45,470 --> 00:29:49,570
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Sam, kau seharusnya tak berada
dalam situasi seperti ini.</font></font></font></font>

517
00:29:50,520 --> 00:29:53,460
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Kau bukan Steve Rogers.</font></font></font></font>

518
00:29:55,620 --> 00:29:56,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ruth,</font></font></font></font>

519
00:29:56,670 --> 00:29:59,530
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Kau memiliki otoritas penuh aku
untuk menyelesaikan masalah ini.</font></font></font></font>

520
00:30:00,530 --> 00:30:02,660
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Sebelum perjanjian ini
terkompromikan lebih jauh.</font></font></font></font>

521
00:30:06,560 --> 00:30:07,560
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Jadi itu saja?</font></font></font></font>

522
00:30:08,640 --> 00:30:09,640
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Aku selesai?</font></font></font></font>

523
00:30:10,560 --> 00:30:11,600
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Kau selesai.</font></font></font></font>

524
00:30:11,620 --> 00:30:13,620
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ini omong kosong, dan kau tahu itu.</font></font></font></font>

525
00:30:13,640 --> 00:30:15,480
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ini politik.</font></font></font></font>

526
00:30:15,670 --> 00:30:17,660
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Jadi lebih baik kau bijaksana, nak.</font></font></font></font>

527
00:30:20,490 --> 00:30:21,660
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">"Nak." Siapa yang kau panggil "nak"?</font></font></font></font>

528
00:30:21,680 --> 00:30:23,650
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Sam. Apa yang kau lakukan?</font></font></font></font>

529
00:30:23,670 --> 00:30:25,460
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Aku akan membersihkan nama Isaiah.</font></font></font></font>

530
00:30:25,480 --> 00:30:26,620
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Menerobos masuk ke sana
tak akan membantunya.</font></font></font></font>

531
00:30:26,640 --> 00:30:28,630
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">- Kau butuh Ross di pihakmu.
- Ross?</font></font></font></font>

532
00:30:29,530 --> 00:30:30,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Buka matamu.</font></font></font></font>

533
00:30:30,610 --> 00:30:32,480
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Aku menawarkan banPak,
dan dia menyuruhku pergi.</font></font></font></font>

534
00:30:32,500 --> 00:30:34,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Ross berada di pihaknya sendiri.
Dia selalu begitu.</font></font></font></font>

535
00:30:35,450 --> 00:30:37,460
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Entah kau tak bisa melihatnya,
atau kau tak mau.</font></font></font></font>

536
00:30:37,480 --> 00:30:38,440
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Hei.</font></font></font></font>

537
00:30:39,470 --> 00:30:40,480
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Jangan jadi orang itu.</font></font></font></font>

538
00:30:40,500 --> 00:30:41,670
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Dan orang seperti apa itu?</font></font></font></font>

539
00:30:42,440 --> 00:30:43,590
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Orang yang harus melakukannya
dengan cara yang sulit.</font></font></font></font>

540
00:30:49,670 --> 00:30:51,610
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Sepertinya aku adalah orang itu.</font></font></font></font>

541
00:31:14,640 --> 00:31:17,450
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14"><i>Negara masih dalam
kewaspadaan tinggi.</i></font></font></font></font>

542
00:31:17,470 --> 00:31:20,490
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14"><i>Departemen Kehakiman telah
menandakan kasus hukuman mati</i></font></font></font></font>

543
00:31:20,520 --> 00:31:22,680
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14"><i>akan dilaksanakan terhadap
Isaiah Bradley.</i></font></font></font></font>

544
00:31:23,450 --> 00:31:24,630
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Hanya lima menit, Kapten.</font></font></font></font>

545
00:31:27,620 --> 00:31:29,670
<font color="#dede02"><font color="#24f109"><font color="#2cec13"><font color="#07ca14">Aku bisa diadili militer karena ini.</font></font></font></font>

