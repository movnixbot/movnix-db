694
00:51:35,926 --> 00:51:37,219
<font color="white">Ada tempat yang mau kulihat.</font><font color="white"></font>

695
00:51:37,302 --> 00:51:38,178
<font color="white">Di mana?</font><font color="white"></font>

696
00:51:39,721 --> 00:51:40,806
<font color="white">Aku mau lihat penguin.</font><font color="white"></font>

697
00:51:42,140 --> 00:51:43,308
<font color="white">Apa?</font><font color="white"></font>

698
00:51:43,391 --> 00:51:45,310
<font color="white">Penguin?</font><font color="white"></font>

699
00:51:53,527 --> 00:51:54,528
<font color="white">Kau pandai.</font><font color="white"></font>

700
00:52:01,701 --> 00:52:03,829
<font color="white">- Hei, bahaya! Lihat ke depan!</font><font color="white">
<font color="white">- Mengagetkan.</font><font color="white"></font></font>

701
00:52:04,412 --> 00:52:06,206
<font color="white">Apa kau mengkhawatirkanku?</font><font color="white"></font>

702
00:52:09,918 --> 00:52:11,461
<font color="white">Berhentilah bertengkar.</font><font color="white"></font>

703
00:52:11,545 --> 00:52:13,672
<font color="white">Hei, Choi Ji-min. Tunggu aku!</font><font color="white"></font>

704
00:52:14,172 --> 00:52:15,465
<font color="white">Pelan-pelan!</font><font color="white"></font>

705
00:52:29,020 --> 00:52:30,105
<font color="white">Imut sekali!</font><font color="white"></font>

706
00:52:30,188 --> 00:52:32,816
<font color="white">- Imutnya.</font><font color="white">
<font color="white">- Benar-benar imut.</font><font color="white"></font></font>

707
00:52:33,608 --> 00:52:34,693
<font color="white">Imutnya!</font><font color="white"></font>

708
00:52:34,776 --> 00:52:35,735
<font color="white">Ji-min!</font><font color="white"></font>

709
00:52:59,217 --> 00:53:00,302
<font color="white">Apa-apaan?</font><font color="white"></font>

710
00:53:01,845 --> 00:53:03,013
<font color="white">Gigimu juga.</font><font color="white"></font>

711
00:53:03,096 --> 00:53:04,598
<font color="white">Lihat gigi kalian.</font><font color="white"></font>

712
00:53:04,681 --> 00:53:06,224
<font color="white">Kenapa kau mau lihat penguin?</font><font color="white"></font>

713
00:53:07,350 --> 00:53:09,144
<font color="white">Penguin imut saat tertatih-tatih.</font><font color="white"></font>

714
00:53:10,061 --> 00:53:11,521
<font color="white">Bukan "terhuyung-huyung"?</font><font color="white"></font>

715
00:53:11,605 --> 00:53:13,106
<font color="white">"Tertatih-tatih" lebih imut.</font><font color="white"></font>

716
00:53:15,108 --> 00:53:16,401
<font color="white">Semoga bisa lihat mereka.</font><font color="white"></font>

717
00:53:16,484 --> 00:53:18,320
<font color="white">- Penguin…</font><font color="white">
<font color="white">- Pasti ini.</font><font color="white"></font></font>

718
00:53:18,403 --> 00:53:20,322
<font color="white">- Ini dia.</font><font color="white">
<font color="white">- Penguin?</font><font color="white"></font></font>

719
00:53:22,073 --> 00:53:22,949
<font color="white">Apa?</font><font color="white"></font>

720
00:53:24,367 --> 00:53:25,285
<font color="white">Di mana penguinnya?</font><font color="white"></font>

721
00:53:26,578 --> 00:53:27,913
{\an8}<font color="white">PENGUIN ISTIRAHAT HARI INI</font><font color="white">
<font color="white">SAMPAI JUMPA LAIN KALI</font><font color="white"></font></font>

722
00:53:27,996 --> 00:53:28,955
<font color="white">Tidak ada penguin?</font><font color="white"></font>

723
00:53:29,831 --> 00:53:32,167
<font color="white">Mereka istirahat. Kemarin kerja keras, ya?</font><font color="white"></font>

724
00:53:32,959 --> 00:53:33,835
<font color="white">Tak apa.</font><font color="white"></font>

725
00:53:34,586 --> 00:53:36,379
<font color="white">Mungkin akan keluar jika kita tunggu.</font><font color="white"></font>

726
00:53:36,880 --> 00:53:37,756
<font color="white">Mau lihat ke sana?</font><font color="white"></font>

727
00:53:37,839 --> 00:53:39,507
<font color="white">- Oke.</font><font color="white">
<font color="white">- Oke.</font><font color="white"></font></font>

728
00:53:40,508 --> 00:53:41,426
<font color="white">Tak apa.</font><font color="white"></font>

729
00:53:48,892 --> 00:53:50,518
<font color="white">Tempat ini luar biasa.</font><font color="white"></font>

730
00:53:51,686 --> 00:53:52,979
<font color="white">Indah sekali.</font><font color="white"></font>

731
00:53:54,022 --> 00:53:55,148
<font color="white">Kupikir kau mungkin suka.</font><font color="white"></font>

732
00:54:00,820 --> 00:54:03,406
<font color="white">Aku sangat senang hari ini.</font><font color="white"></font>

733
00:54:06,493 --> 00:54:07,494
<font color="white">Indah sekali.</font><font color="white"></font>

734
00:54:17,879 --> 00:54:20,090
<font color="white">Kim Jae-won! Ayo!</font><font color="white"></font>

735
00:54:21,257 --> 00:54:22,300
<font color="white">Sejuk sekali.</font><font color="white"></font>

736
00:54:23,259 --> 00:54:24,260
<font color="white">Hati-hati.</font><font color="white"></font>

737
00:54:32,894 --> 00:54:34,729
<font color="white">Tidak, jangan begitu.</font><font color="white"></font>

738
00:54:34,813 --> 00:54:36,856
<font color="white">Serius, jangan begitu. Nanti kubalas.</font><font color="white"></font>

739
00:55:17,897 --> 00:55:20,358
<font color="white">Bagaimana cara mengikat</font><font color="white">
<font color="white">tali sepatu seperti itu?</font><font color="white"></font></font>

740
00:55:38,626 --> 00:55:39,669
<font color="white">Lakukan seperti ini,</font><font color="white"></font>

741
00:55:40,587 --> 00:55:41,713
<font color="white">atau nanti bisa lepas.</font><font color="white"></font>

742
00:55:43,256 --> 00:55:44,257
<font color="white">Kelihatannya rumit.</font><font color="white"></font>

743
00:55:52,474 --> 00:55:53,808
<font color="white">Tak apa.</font><font color="white"></font>

744
00:55:53,892 --> 00:55:55,643
<font color="white">Akan kuikatkan untukmu.</font><font color="white"></font>

745
00:56:00,774 --> 00:56:02,567
<font color="white">Tempat ini benar-benar indah.</font><font color="white"></font>

746
00:56:03,610 --> 00:56:04,486
<font color="white">Benar.</font><font color="white"></font>

747
00:56:06,488 --> 00:56:07,405
<font color="white">Ayo</font><font color="white"></font>

748
00:56:08,531 --> 00:56:09,532
<font color="white">ke sini lagi nanti.</font><font color="white"></font>

749
00:56:10,200 --> 00:56:11,785
<font color="white">Oke, ayo ke sini lagi.</font><font color="white"></font>

750
00:56:17,040 --> 00:56:18,333
<font color="white">Dan berlalulah</font><font color="white"></font>

751
00:56:19,334 --> 00:56:20,668
<font color="white">satu hari lagi.</font><font color="white"></font>

752
00:56:30,595 --> 00:56:31,596
<font color="white">Dirimu yang besok…</font><font color="white"></font>

753
00:56:33,723 --> 00:56:35,433
<font color="white">akan kubuat bahagia juga.</font><font color="white"></font>

754
00:56:43,108 --> 00:56:45,235
<font color="white">Itu norak sekali!</font><font color="white"></font>

755
00:56:45,819 --> 00:56:48,154
<font color="white">Kau tak suka?</font><font color="white"></font>

756
00:56:48,863 --> 00:56:51,866
<font color="white">Bukannya tak suka, tapi itu norak sekali.</font><font color="white"></font>

757
00:56:52,367 --> 00:56:54,494
<font color="white">Serius, norak sekali!</font><font color="white"></font>

758
00:56:54,994 --> 00:56:55,954
<font color="white">Aku mau pulang.</font><font color="white"></font>

759
00:57:03,419 --> 00:57:07,465
