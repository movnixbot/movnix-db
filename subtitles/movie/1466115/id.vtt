760
00:57:24,357 --> 00:57:26,317
<font color="white">Ada apa? Kita mau ke mana?</font><font color="white"></font>

761
00:57:26,401 --> 00:57:28,570
<font color="white">Entahlah. Aku juga tak tahu.</font><font color="white"></font>

762
00:57:28,653 --> 00:57:29,487
<font color="white">Kau tak tahu?</font><font color="white"></font>

763
00:57:45,211 --> 00:57:46,087
<font color="white">Ta-da!</font><font color="white"></font>

764
00:57:47,338 --> 00:57:48,840
<font color="white">- Halo.</font><font color="white">
<font color="white">- Apa? Kim Jae-won!</font><font color="white"></font></font>

765
00:57:48,923 --> 00:57:52,844
<font color="white">Inilah penguin paling tampan</font><font color="white">
<font color="white">dan imut di dunia!</font><font color="white"></font></font>

766
00:57:52,927 --> 00:57:54,762
<font color="white">- Dasar gila.</font><font color="white">
<font color="white">- Astaga.</font><font color="white"></font></font>

767
00:57:54,846 --> 00:57:57,182
<font color="white">Sudah kubilang</font><font color="white">
<font color="white">gadis-gadis suka kejutan, 'kan?</font><font color="white"></font></font>

768
00:57:57,265 --> 00:57:58,183
<font color="white">Aku benar, 'kan?</font><font color="white"></font>

769
00:57:58,266 --> 00:57:59,809
<font color="white">- Dia mentertawakanku.</font><font color="white">
<font color="white">- Tidak!</font><font color="white"></font></font>

770
00:57:59,893 --> 00:58:03,229
<font color="white">- Sudah kubilang aku tak mau!</font><font color="white">
<font color="white">- Diamlah. Dia terlihat senang.</font><font color="white"></font></font>

771
00:58:03,313 --> 00:58:04,939
<font color="white">Hei, ayolah.</font><font color="white"></font>

772
00:58:05,023 --> 00:58:06,065
<font color="white">Aku mau pergi.</font><font color="white"></font>

773
00:58:06,149 --> 00:58:07,066
<font color="white">Tunggu!</font><font color="white"></font>

774
00:58:07,150 --> 00:58:10,236
<font color="white">Tunggu, Tuan Penguin! Biar kufoto dulu.</font><font color="white"></font>

775
00:58:10,820 --> 00:58:12,071
<font color="white">Kau imut sekali!</font><font color="white"></font>

776
00:58:12,614 --> 00:58:15,492
<font color="white">- Foto aku juga, Ji-min.</font><font color="white">
<font color="white">- Jangan malu. Kau menggemaskan.</font><font color="white"></font></font>

777
00:58:15,575 --> 00:58:18,495
<font color="white">Ini sebabnya kau menggangguku</font><font color="white">
<font color="white">beberapa hari terakhir?</font><font color="white"></font></font>

778
00:58:18,578 --> 00:58:19,913
<font color="white">Bagaimana? Lumayan, 'kan?</font><font color="white"></font>

779
00:58:19,996 --> 00:58:22,874
<font color="white">- Ayolah. Hentikan.</font><font color="white">
<font color="white">- Kemari. Tolong sekali saja.</font><font color="white"></font></font>

780
00:58:22,957 --> 00:58:25,710
<font color="white">- Lakukan pose imut.</font><font color="white">
<font color="white">- Tidak.</font><font color="white"></font></font>

781
00:58:25,793 --> 00:58:26,711
<font color="white">Berikan pose imut.</font><font color="white"></font>

